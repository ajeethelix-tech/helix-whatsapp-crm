            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ chatId: $json.chatId, message: $json.reply }) }}",
        "options": {}
      },
      "id": "11111111-1111-1111-1111-000000000005",
