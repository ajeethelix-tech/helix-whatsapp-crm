            }
          ],
          "combinator": "and"
        }
      },
      "id": "11111111-1111-1111-1111-000000000002",
      "name": "Is Text Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// PASTE THE FULL CONTENT OF intent_detection.js HERE\n// File: helix-whatsapp-bot/intent_detection.js\n// Select All in Notepad > Copy > Paste here\n\nreturn [{ json: { chatId: '', senderName: '', rawMessage: '', intent: 'unknown', reply: 'placeholder', messageType: 'text', timestamp: new Date().toISOString() } }];"
      },
      "id": "11111111-1111-1111-1111-000000000003",
      "name": "Build Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json[\"messageType\"] }}",
        "rules": {
          "rules": [
            { "value2": "text",  "output": 0 },
            { "value2": "file",  "output": 1 },
            { "value2": "human", "output": 2 }
          ]
        },
        "fallbackOutput": 0
      },
      "id": "11111111-1111-1111-1111-000000000004",
      "name": "Message Type?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [900, 300]
